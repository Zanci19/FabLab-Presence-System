{
  // -------------------------------------------------------------------------
  // IntelliSense configuration for the ESP32-S3 PlatformIO project.
  //
  // HOW IT WORKS:
  //   After you run a PlatformIO build ("pio run" or the ✓ button) for the
  //   first time, PlatformIO generates:
  //     esp32-firmware/.pio/build/fablab_esp32s3/compile_commands.json
  //   VS Code then uses that file (via "compileCommands" below) and all the
  //   red #include squiggles disappear automatically.
  //
  //   Until that first build the fallback "includePath" entries below are
  //   used. They require PlatformIO to have been installed at least once
  //   (so the ~/.platformio packages exist on disk).
  // -------------------------------------------------------------------------
  "configurations": [
    {
      "name": "ESP32 PlatformIO",
      // Primary IntelliSense source – generated by "pio run":
      "compileCommands": "${workspaceFolder}/esp32-firmware/.pio/build/fablab_esp32s3/compile_commands.json",
      // Compiler used for built-in macro detection (Xtensa cross-compiler):
      "compilerPath": "${env:USERPROFILE}\\.platformio\\packages\\toolchain-xtensa-esp-elf\\bin\\xtensa-esp32s3-elf-g++.exe",
      "cStandard": "c11",
      "cppStandard": "c++17",
      // gcc-x64 is the closest supported mode for a GCC cross-compiler;
      // compileCommands overrides this once the project has been built.
      "intelliSenseMode": "gcc-x64",
      // Fallback include paths (active only when compileCommands does not exist):
      "includePath": [
        "${workspaceFolder}/esp32-firmware/src",
        "${workspaceFolder}/esp32-firmware/include",
        "${workspaceFolder}/esp32-firmware/.pio/libdeps/fablab_esp32s3/**",
        "${env:USERPROFILE}/.platformio/packages/framework-arduinoespressif32/**",
        "${env:USERPROFILE}/.platformio/packages/framework-arduinoespressif32/tools/sdk/esp32s3/include/**",
        "${env:USERPROFILE}/.platformio/packages/toolchain-xtensa-esp-elf/**"
      ],
      "defines": [
        "PLATFORMIO=60100",
        "ARDUINO=10819",
        "ARDUINO_ARCH_ESP32",
        "ARDUINO_ESP32S3_DEV",
        "BOARD_HAS_PSRAM",
        "ESP32",
        "ESP_PLATFORM",
        "LV_CONF_INCLUDE_SIMPLE"
      ]
    }
  ],
  "version": 4
}
